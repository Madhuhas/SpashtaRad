# SpashtaRad AI backend configuration.
#
# The backend reads `.env` from the directory it is started in, so copy this to
# apps/backend/.env:
#
#   Copy-Item .env.example apps\backend\.env
#
# Every value below is the built-in default (see apps/backend/app/core/config.py);
# a line only needs to stay if you change it. List values are JSON arrays.

# development | test | production. Production refuses to start with dev auth,
# unauthenticated CDS Hooks, the default UID salt, or a "*" CORS origin.
SPASHTA_ENVIRONMENT=development
SPASHTA_LOG_LEVEL=INFO

# --- HTTP ---
SPASHTA_CORS_ORIGINS=["http://localhost:5173"]
SPASHTA_FRONTEND_URL=http://localhost:5173
SPASHTA_PUBLIC_API_URL=http://localhost:8000
SPASHTA_MAX_UPLOAD_BYTES=268435456

# --- Persistence ---
SPASHTA_DATABASE_URL=sqlite+aiosqlite:///./data/spashtarad.db
# With `docker compose --profile postgres` (also `pip install asyncpg`):
# SPASHTA_DATABASE_URL=postgresql+asyncpg://spashtarad:spashtarad@localhost:5432/spashtarad
SPASHTA_DATA_DIR=./data

# --- PACS (DICOMweb); matches docker/docker-compose.yml ---
SPASHTA_DICOMWEB_URL=http://localhost:8042/dicom-web
SPASHTA_DICOMWEB_USERNAME=spashtarad
SPASHTA_DICOMWEB_PASSWORD=spashtarad
SPASHTA_DICOMWEB_TIMEOUT_SECONDS=60

# --- Authentication: dev | oidc ---
SPASHTA_AUTH_MODE=dev
# SPASHTA_OIDC_ISSUER=https://idp.example.org/realms/radiology
# SPASHTA_OIDC_AUDIENCE=spashtarad-api
# SPASHTA_OIDC_JWKS_URL=https://idp.example.org/realms/radiology/protocol/openid-connect/certs
SPASHTA_OIDC_ROLES_CLAIM=roles

# --- SMART on FHIR ---
SPASHTA_SMART_CLIENT_ID=spashtarad-dev
SPASHTA_SMART_REDIRECT_URI=http://localhost:5173/api/v1/fhir/callback
SPASHTA_SMART_SCOPES=openid fhirUser patient/Patient.read patient/Encounter.read
# Default: the public SMART Health IT sandbox as a simulated EHR.
SPASHTA_SMART_ALLOWED_ISSUERS=["https://launch.smarthealthit.org/v/r4/sim/WzIsIiIsIiIsIkFVVE8iLDAsMCwwLCIiLCIiLCIiLCIiLCIiLCIiLCIiLDAsMV0/fhir"]

# --- CDS Hooks: none | jwt ---
# "none" accepts unauthenticated hook calls and is refused in production.
# With "jwt", each EHR must be registered here: the `iss` of the JWT it signs
# every hook call with, mapped to the URL of its JWKS. The JWT's `aud` must be
# SPASHTA_PUBLIC_API_URL + the service path, e.g.
# http://localhost:8000/cds-services/spashtarad-imaging-alert
SPASHTA_CDS_AUTH_MODE=none
# SPASHTA_CDS_TRUSTED_CLIENTS={"https://ehr.example.org": "https://ehr.example.org/.well-known/jwks.json"}

# --- De-identification ---
# Secret key for deterministic UID remapping. Set a private value and keep it
# stable: rotating it breaks linkage between previously de-identified studies.
SPASHTA_DEID_UID_SALT=dev-only-change-me

# --- AI engine ---
SPASHTA_AI_DEVICE=cpu
SPASHTA_AI_POSITIVE_THRESHOLD=0.5
SPASHTA_AI_MAX_HEATMAPS=5
SPASHTA_AI_ENABLE_ZERO_SHOT=true
# Optional MURA-style checkpoint for musculoskeletal studies; without it MSK
# studies fall back to zero-shot.
# SPASHTA_AI_MSK_WEIGHTS_PATH=C:/models/mura_densenet169.pt

# --- Frontend dev server (read by apps/frontend/vite.config.ts, not the backend) ---
# SPASHTA_BACKEND_URL=http://127.0.0.1:8000
